# Local: copy to .env, fill in, run `node --env-file=.env server.js`. On Vercel the same names are Environment Variables.
# Supabase project: Project Settings > API (URL and publishable key). DB_SECRET = the string you put in supabase/schema.sql.
SUPABASE_URL=
SUPABASE_KEY=
DB_SECRET=
# Apps Script web-app URL (Deploy > Web app), ends in /exec, and the SECRET inside apps-script/Code.gs
SCRIPT_URL=
SCRIPT_SECRET=
# The Google Sheet that gets the results. To switch to another sheet, change this link (and redeploy / restart).
SHEET_LINK=
# Time zone for the times in the sheet
EXAM_TZ=Asia/Dhaka
# PORT=3001
