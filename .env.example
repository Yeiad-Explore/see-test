# Copy to .env, fill in, then run: node --env-file=.env server.js
# Apps Script web-app URL (Deploy > Web app), ends in /exec
SCRIPT_URL=
# Same value as SECRET in apps-script/Code.gs
SCRIPT_SECRET=
# The Google Sheet that gets the results. To switch to another sheet, change this link and restart.
SHEET_LINK=
# PORT=3001
